# ============================================================
# Justice Ultimate Automobiles — USSD Backend Environment
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# Server
PORT=10000
NODE_ENV=production

# Supabase (server-side only — service role key must NEVER be exposed to clients)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Africa's Talking
AT_USERNAME=
AT_API_KEY=
AT_ENVIRONMENT=production
